{
  "name": "@sebasoft/neuron-js",
  "version": "0.4.0",
  "type": "module",
  "description": "AI-friendly TypeScript rules engine for serializable JSON business rules and deterministic workflow decisions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebaSOFT/neuron-js.git"
  },
  "packageManager": "yarn@4.13.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tshy",
    "dev": "vitest",
    "test": "vitest run",
    "examples": "yarn build && node examples/pricing-rules/run.ts && node examples/eligibility-check/run.ts && node examples/workflow-routing/run.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "yarn build",
    "prepublishOnly": "yarn build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "tshy": "^4.1.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.5"
  },
  "tshy": {
    "exports": {
      ".": "./src/index.ts"
    },
    "selfReferencing": false
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src",
    "examples",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "keywords": [
    "rules-engine",
    "rule-engine",
    "json-rules",
    "business-rules",
    "decision-engine",
    "json-logic",
    "workflow-automation",
    "typescript",
    "javascript",
    "nodejs",
    "browser",
    "ai-agents",
    "llm",
    "mcp",
    "deterministic",
    "functional-programming",
    "validation",
    "feature-flags",
    "policy-engine",
    "authorization",
    "n8n",
    "langgraph"
  ]
}
