{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.ts",
      "benchmarks/**/*.ts",
      "package.json",
      "biome.json",
      "tsconfig.json",
      "vitest.config.ts",
      "!!dist",
      "!!node_modules",
      "!!legacy",
      "!!docs",
      "!!.tshy",
      "!!.yarn"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  }
}
