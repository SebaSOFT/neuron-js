{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "includes": ["src/**/*.ts", "package.json", "biome.json", "tsconfig.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": ["src/**/*.ts", "package.json", "biome.json", "tsconfig.json"]
  }
}
